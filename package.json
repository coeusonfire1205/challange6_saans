{
  "name": "saans-air-quality-assistant",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Challenge 06: Urban Air Quality Assistant",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --watch --env-file-if-exists=.env server.mjs",
    "test": "node --test",
    "check": "npm run format:check && node scripts/check-syntax.mjs && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
