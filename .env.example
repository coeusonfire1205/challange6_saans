PORT=3060

# Live AQI, city search and the world map do not require an AI key.
# Add all THREE cloud settings below for your OpenAI-compatible provider.
# AI_BASE_URL must end at the API root, e.g. https://your-provider.example/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional local AI alternative; used when cloud settings are blank.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# After editing this file, restart START.bat / npm start.
# This file is an example. Put real secrets in .env, which Git ignores.
